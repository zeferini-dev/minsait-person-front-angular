{
  "name": "minsait-person-front-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:vitest": "vitest --config tests/vitest/vitest.config.ts",
    "test:vitest:watch": "vitest --watch --config tests/vitest/vitest.config.ts",
    "test:vitest:coverage": "vitest run --coverage --config tests/vitest/vitest.config.ts",
    "test:jest": "jest --config tests/jest/jest.config.js",
    "test:jest:watch": "jest --watch --config tests/jest/jest.config.js",
    "e2e:cypress": "cypress open --project tests/cypress",
    "e2e:cypress:run": "cypress run --project tests/cypress",
    "e2e:cypress:run:ci": "start-server-and-test start http://localhost:4200 e2e:cypress:run",
    "e2e:playwright": "playwright test --config tests/e2e-playwright/playwright.config.ts",
    "e2e:playwright:ui": "playwright test --ui --config tests/e2e-playwright/playwright.config.ts",
    "e2e:playwright:headed": "playwright test --headed --config tests/e2e-playwright/playwright.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.49.0",
    "@types/jest": "^29.5.14",
    "cypress": "^13.15.0",
    "jest": "^29.7.0",
    "jsdom": "^27.1.0",
    "start-server-and-test": "^2.1.5",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
