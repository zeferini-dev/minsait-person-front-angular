# Auto detect text files and normalize line endings to LF
* text=auto

# TypeScript and JavaScript files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Angular specific
angular.json text eol=lf
tsconfig.*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.tar binary
*.gz binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Office documents
*.docx binary
*.xlsx binary
*.pptx binary
